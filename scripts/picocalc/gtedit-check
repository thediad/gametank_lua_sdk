#!/bin/bash
set -u

SDK=${GTLUA_SDK:-/home/pico/dev/gametank/gametank_lua_sdk}
LOG=${GTDEV_BUILD_LOG:-$HOME/.gtbuild-last.log}
REOPEN=${GTEDIT_REOPEN:-}

wait_and_drain() {
    local deadline=$((SECONDS + $1))
    local ignored
    while (( SECONDS < deadline )); do
        IFS= read -rsn1 -t 0.2 ignored < /dev/tty || true
    done
}
if [ -f ./gtlua.json ]; then
    node "$SDK/bin/gtlua.js" check > "$LOG" 2>&1
    rc=$?
elif [ -n "${GTEDIT_SOURCE:-}" ]; then
    node "$SDK/bin/gtlua.js" check "$GTEDIT_SOURCE" > "$LOG" 2>&1
    rc=$?
else
    printf '%s\n' 'gtedit-check: project or source could not be resolved' > "$LOG"
    rc=1
fi

location=$(sed -n 's/^[^:]*:\([0-9][0-9]*\):\([0-9][0-9]*\): error:.*/\1,\2/p' "$LOG" | head -n 1)
if [ -n "$REOPEN" ]; then
    if [ -n "$location" ]; then printf '%s\n' "$location" > "$REOPEN"
    else printf '%s\n' reopen > "$REOPEN"
    fi
fi

if [ -c /dev/tty ] && ( : > /dev/tty ) 2>/dev/null; then
    printf '\033[2J\033[H' > /dev/tty
    while IFS= read -r line || [ -n "$line" ]; do
        printf '%s\r\n' "$line"
    done < "$LOG" > /dev/tty
    if [ -n "$location" ]; then
        printf '\r\nOpening error at %s in 6 seconds; keys are ignored...' "$location" > /dev/tty
    else
        printf '\r\nReturning in 6 seconds; keys are ignored...' > /dev/tty
    fi
    wait_and_drain 6
else
    cat "$LOG" >&2
fi
# The diagnostic status is preserved in the log. Return success so Nano can
# finish the binding and exit into gtdev's controlled reopen loop.
exit 0
