#!/bin/bash
set -u

SDK=/home/pico/dev/gametank/gametank_lua_sdk
EMU=${GTDEV_EMULATOR:-/home/pico/dev/gametank/emulator-picocalc/bin/GameTankEmulator}
WORKSPACE=/home/pico/dev/gametank/workspace
LOG=/home/pico/.gtbuild-last.log
GTDEV_EDITOR=${GTDEV_EDITOR:-nano}
GTDEV_NANORC=${GTDEV_NANORC:-$HOME/.config/gtdev/nanorc}

fail() {
    printf 'gtdev: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
GameTank Lua shortcuts:
  gtstudio PROJECT interactive edit/check/build/run/help suite
  gtnew NAME       create a project under ~/dev/gametank/workspace
  gtedit PROJECT   edit main.lua with Nano
  gtcheck PROJECT  validate Lua and declared project assets
  gtbuild PROJECT  build game.gtr
  gtplay PROJECT   open the existing game.gtr
  gtrun PROJECT    build and open game.gtr
  gtdev PROJECT    edit, then build and open game.gtr
  gtlog            view the last build log
  gtapi [WORDS]    browse or search offline API help
  gthelp [WORDS]   alias for gtapi

PROJECT may be a workspace name, project directory, main.lua, or game.gtr.
Builds automatically use gfx.gtg, gfx.gff, level.map, and gfx.gsi when present.
Extra gtlua build options may follow PROJECT.
PICOCALC_SCALE defaults to 2; override it for a different supported scale.
EOF
}

command_name=${0##*/}
case "$command_name" in
    gtstudio) action=studio ;;
    gtnew|gtedit|gtcheck|gtbuild|gtplay|gtrun|gtlog) action=${command_name#gt} ;;
    gtdev)
        case "${1:-}" in
            --help|-h|help) action=help; shift ;;
            *) action=dev ;;
        esac ;;
    *) action=${1:-help}; [ "$#" -gt 0 ] && shift ;;
esac

if [ "$action" = help ] || [ "$action" = --help ] || [ "$action" = -h ]; then
    usage
    exit 0
fi

if [ "$action" = log ]; then
    [ -s "$LOG" ] || fail "no build log exists yet"
    if command -v less >/dev/null 2>&1; then
        exec less "$LOG"
    fi
    exec cat "$LOG"
fi

if [ "$action" = new ]; then
    [ "$#" -eq 1 ] || fail 'usage: gtnew NAME'
    name=$1
    case "$name" in
        ''|[!a-z0-9]*|*[!a-z0-9_-]*)
            fail 'use a lowercase name starting with a letter or digit; allowed: a-z, 0-9, _ and -' ;;
    esac
    [ -f "$SDK/bin/gtlua.js" ] || fail "SDK not found: $SDK"
    mkdir -p "$WORKSPACE"
    project=$WORKSPACE/$name
    node "$SDK/bin/gtlua.js" init "$project" || exit $?
    printf 'Start with: gtdev %s\n' "$name"
    exit 0
fi

[ "$#" -ge 1 ] || { usage >&2; exit 2; }
target=$1
shift

if [ -e "$target" ]; then
    resolved=$target
elif [ -e "$WORKSPACE/$target" ]; then
    resolved=$WORKSPACE/$target
else
    fail "project not found: $target"
fi

if [ -d "$resolved" ]; then
    project=$(cd "$resolved" && pwd -P)
    source=$project/main.lua
    rom=$project/game.gtr
else
    project=$(cd "$(dirname "$resolved")" && pwd -P)
    file=$project/$(basename "$resolved")
    case "$file" in
        *.lua) source=$file; rom=${file%.lua}.gtr ;;
        *.gtr) source=$project/main.lua; rom=$file ;;
        *) fail 'expected a project directory, .lua source, or .gtr ROM' ;;
    esac
fi

[ -f "$source" ] || fail "Lua source not found: $source"
[ -f "$SDK/bin/gtlua.js" ] || fail "SDK not found: $SDK"
[ -x "$EMU" ] || fail "emulator not found: $EMU"

edit() {
    [ -r "$GTDEV_NANORC" ] || fail "Nano configuration not found: $GTDEV_NANORC"
    local reopen
    local location=
    local args
    reopen=$(mktemp /tmp/gtedit-reopen.XXXXXX) || fail 'cannot create editor state file'
    rm -f "$reopen"
    while true; do
        args=(--rcfile "$GTDEV_NANORC")
        case "$location" in
            [0-9]*,[0-9]*) args+=("+$location") ;;
        esac
        args+=("$source")
        (cd "$project" && GTEDIT_PROJECT="$project" GTEDIT_SOURCE="$source" GTEDIT_ROM="$rom" \
            GTEDIT_REOPEN="$reopen" "$GTDEV_EDITOR" "${args[@]}")
        [ -f "$reopen" ] || break
        location=$(cat "$reopen")
        rm -f "$reopen"
    done
    rm -f "$reopen"
}

build() {
    if [ -f "$project/gtlua.json" ]; then
        printf 'Building project %s\n' "$project"
        (cd "$project" && GTLUA_TOOLCHAIN=wasm node "$SDK/bin/gtlua.js" build "$@") \
            2>&1 | tee "$LOG"
        local rc=${PIPESTATUS[0]}
        if [ "$rc" -ne 0 ]; then
            printf '\nBuild failed. Review with: gtlog\n' >&2
            return "$rc"
        fi
        printf 'ROM: %s\n' "$rom"
        return 0
    fi

    local args=()
    [ -f "$project/gfx.gtg" ] && args+=(--sheet "$project/gfx.gtg")
    [ -f "$project/gfx.gff" ] && args+=(--gff "$project/gfx.gff")
    [ -f "$project/level.map" ] && args+=(--map "$project/level.map")
    [ -f "$project/gfx.gsi" ] && args+=(--frames "$project/gfx.gsi")

    printf 'Building %s\n' "$source"
    GTLUA_TOOLCHAIN=wasm node "$SDK/bin/gtlua.js" build "$source" \
        -o "$rom" "${args[@]}" "$@" 2>&1 | tee "$LOG"
    local rc=${PIPESTATUS[0]}
    if [ "$rc" -ne 0 ]; then
        printf '\nBuild failed. Review with: gtlog\n' >&2
        return "$rc"
    fi
    printf 'ROM: %s\n' "$rom"
}

check() {
    if [ -f "$project/gtlua.json" ]; then
        (cd "$project" && node "$SDK/bin/gtlua.js" check "$@") 2>&1 | tee "$LOG"
    else
        node "$SDK/bin/gtlua.js" check "$source" "$@" 2>&1 | tee "$LOG"
    fi
    local rc=${PIPESTATUS[0]}
    if [ "$rc" -ne 0 ]; then
        printf '\nCheck failed. Review with: gtlog\n' >&2
    fi
    return "$rc"
}

play() {
    [ -f "$rom" ] || fail "ROM not found: $rom (run gtbuild first)"
    PICOCALC_SCALE="${PICOCALC_SCALE:-2}" "$EMU" "$rom"
}

pause_for_key() {
    printf '\nPress Enter to return to GTStudio...'
    IFS= read -r _unused
}

studio() {
    while true; do
        clear
        printf '%s\n' 'GameTank Lua Studio'
        printf '%s\n' '-------------------'
        printf 'Project: %s\n\n' "${project##*/}"
        printf '%s\n' \
            '1  Edit code' \
            '2  Check project' \
            '3  Build ROM' \
            '4  Build and run' \
            '5  API help' \
            '6  Last build log' \
            '7  Project and assets' \
            '8  Register assets' \
            'Q  Quit'
        printf '\nChoice: '
        IFS= read -r choice
        case "$choice" in
            1|e|E) edit ;;
            2|c|C) check "$@"; pause_for_key ;;
            3|b|B) build "$@"; pause_for_key ;;
            4|r|R) if build "$@"; then play; else pause_for_key; fi ;;
            5|h|H)
                if command -v gtapi >/dev/null 2>&1; then gtapi; else node "$SDK/bin/gtapi.js"; fi ;;
            6|l|L)
                if [ -s "$LOG" ]; then
                    if command -v less >/dev/null 2>&1; then less "$LOG"; else cat "$LOG"; pause_for_key; fi
                else
                    printf '\nNo build log exists yet.\n'
                    pause_for_key
                fi ;;
            7|p|P)
                (cd "$project" && node "$SDK/bin/gtlua.js" project) 2>&1
                pause_for_key ;;
            8|a|A) asset_menu ;;
            q|Q|0) return 0 ;;
            *) printf '\nUnknown choice.\n'; pause_for_key ;;
        esac
    done
}

asset_menu() {
    while true; do
        clear
        printf '%s\n' 'GTStudio Asset Registration' '---------------------------'
        printf '%s\n' \
            '1  Set sprite sheet (.gtg)' \
            '2  Set sprite flags (.gff)' \
            '3  Set tile map (.map)' \
            '4  Set frame table (.gsi)' \
            '5  Add song (.gtm2)' \
            '6  Import graphics or PICO-8 cart' \
            '7  Create a blank native asset' \
            '8  Unregister an asset' \
            '9  Preview registered sprite sheet' \
            '10 Preview registered tile map' \
            'B  Back'
        printf '\nChoice: '
        IFS= read -r choice
        case "$choice" in
            1) kind=sheet ;;
            2) kind=flags ;;
            3) kind=map ;;
            4) kind=frames ;;
            5) kind=song ;;
            6)
                printf 'Source image/cart path: '
                IFS= read -r asset_file
                printf 'Output name [gfx.gtg]: '
                IFS= read -r output_file
                output_file=${output_file:-gfx.gtg}
                (cd "$project" && node "$SDK/bin/gtlua.js" asset import "$asset_file" -o "$output_file")
                pause_for_key
                continue ;;
            7)
                printf 'Kind to create (sheet/flags/map): '
                IFS= read -r kind
                printf 'Output name [default]: '
                IFS= read -r output_file
                if [ -n "$output_file" ]; then
                    (cd "$project" && node "$SDK/bin/gtlua.js" asset create "$kind" "$output_file")
                else
                    (cd "$project" && node "$SDK/bin/gtlua.js" asset create "$kind")
                fi
                pause_for_key
                continue ;;
            8)
                printf 'Kind to unregister (sheet/flags/map/frames): '
                IFS= read -r kind
                (cd "$project" && node "$SDK/bin/gtlua.js" asset unset "$kind")
                pause_for_key
                continue ;;
            9)
                if (cd "$project" && GTLUA_TOOLCHAIN=wasm node "$SDK/bin/gtlua.js" asset preview sheet); then
                    PICOCALC_SCALE="${PICOCALC_SCALE:-2}" "$EMU" "$project/build/gtstudio-sheet-preview.gtr"
                else
                    pause_for_key
                fi
                continue ;;
            10)
                if (cd "$project" && GTLUA_TOOLCHAIN=wasm node "$SDK/bin/gtlua.js" asset preview map); then
                    PICOCALC_SCALE="${PICOCALC_SCALE:-2}" "$EMU" "$project/build/gtstudio-map-preview.gtr"
                else
                    pause_for_key
                fi
                continue ;;
            b|B|q|Q) return 0 ;;
            *) printf '\nUnknown choice.\n'; pause_for_key; continue ;;
        esac
        printf 'Existing project-relative file: '
        IFS= read -r asset_file
        if [ "$kind" = song ]; then
            (cd "$project" && node "$SDK/bin/gtlua.js" asset add-song "$asset_file")
        else
            (cd "$project" && node "$SDK/bin/gtlua.js" asset set "$kind" "$asset_file")
        fi
        pause_for_key
    done
}

case "$action" in
    edit)
        edit ;;
    check)
        check "$@" ;;
    build)
        build "$@" ;;
    play)
        play ;;
    run)
        build "$@" && play ;;
    studio)
        studio "$@" ;;
    dev)
        edit && build "$@" && play ;;
    *)
        fail "unknown action: $action" ;;
esac
