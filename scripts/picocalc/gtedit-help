#!/bin/bash
set -u

SDK=${GTLUA_SDK:-/home/pico/dev/gametank/gametank_lua_sdk}
CACHE=${GTDEV_HELP_CACHE:-$HOME/.config/gtdev/api-help-cache}
LOG=${GTDEV_HELP_LOG:-$HOME/.gthelp-last.log}
selection=$(mktemp /tmp/gtedit-help.XXXXXX) || exit 1
trap 'rm -f "$selection"' EXIT HUP INT TERM
cat > "$selection"

wait_and_drain() {
    local deadline=$((SECONDS + $1))
    local ignored
    while (( SECONDS < deadline )); do
        IFS= read -rsn1 -t 0.2 ignored < /dev/tty || true
    done
}

query=$(tr -cd 'A-Za-z0-9_.' < "$selection")
key=$(printf '%s' "$query" | tr 'A-Z' 'a-z')
if [ -n "$key" ] && [ -f "$CACHE/$key.txt" ]; then
    cp "$CACHE/$key.txt" "$LOG"
elif [ -n "$query" ]; then
    node "$SDK/bin/gtapi.js" "$query" > "$LOG" 2>&1 || true
else
    printf '%s\n' 'No API identifier is under the cursor.' > "$LOG"
fi

if [ -c /dev/tty ] && ( : > /dev/tty ) 2>/dev/null; then
    printf '\033[2J\033[H' > /dev/tty
    while IFS= read -r line || [ -n "$line" ]; do
        printf '%s\r\n' "$line"
    done < "$LOG" > /dev/tty
    printf '\r\nReturning in 8 seconds; keys are ignored...' > /dev/tty
    wait_and_drain 8
else
    cat "$LOG" >&2
fi

cat "$selection"
